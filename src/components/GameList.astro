---
import EmptyState from './EmptyState.astro';
import GameCard from './GameCard.astro';
import type { GamesPage } from '../lib/games';
import type { Game } from '../types/game';

interface Props {
    gamesPage: GamesPage;
    allGames: Game[];
}

const { gamesPage, allGames } = Astro.props;
const pagePath = (page: number): string => page === 1 ? '/' : `/page/${page}`;
const currentPageGameIds = new Set(gamesPage.games.map((game) => game.id));
const displayGames = [
  ...gamesPage.games,
  ...allGames.filter((game) => !currentPageGameIds.has(game.id)),
];
---

<section aria-label="Search games" data-testid="game-search">
  <label for="game-search-input" class="mb-2 block text-sm font-medium text-slate-200">
    Search games by title
  </label>
  <input
    id="game-search-input"
    type="search"
    placeholder="Search by title"
    autocomplete="off"
    class="mb-8 w-full rounded-lg border border-slate-600 bg-slate-800 px-4 py-3 text-slate-100 placeholder:text-slate-400 focus:ring-2 focus:ring-blue-500 focus:outline-none"
    data-testid="game-search-input"
  />
</section>

{allGames.length === 0 ? (
  <EmptyState text="No games available at the moment." />
) : (
  <>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6" data-testid="games-grid">
      {displayGames.map((game) => (
        <GameCard game={game} hidden={!gamesPage.games.some((pageGame) => pageGame.id === game.id)} />
      ))}
    </div>

    <div
      class="mt-8"
      data-testid="search-empty-state"
      role="status"
      aria-live="polite"
      hidden
    >
      <EmptyState text="No games match your search." />
    </div>

    {gamesPage.totalPages > 1 && (
      <nav class="mt-8 flex items-center justify-center gap-2" aria-label="Game list pagination" data-testid="pagination">
        {gamesPage.currentPage > 1 && (
          <a
            href={pagePath(gamesPage.currentPage - 1)}
            aria-label="Go to previous page"
            class="rounded-lg border border-slate-700 px-4 py-2 text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="pagination-previous"
          >
            Previous
          </a>
        )}

        {Array.from({ length: gamesPage.totalPages }, (_, index) => index + 1).map((page) => (
          page === gamesPage.currentPage ? (
            <span
              aria-current="page"
              aria-label={`Page ${page}, current page`}
              class="rounded-lg bg-blue-600 px-4 py-2 text-white"
              data-testid={`pagination-page-${page}`}
            >
              {page}
            </span>
          ) : (
            <a
              href={pagePath(page)}
              aria-label={`Go to page ${page}`}
              class="rounded-lg border border-slate-700 px-4 py-2 text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid={`pagination-page-${page}`}
            >
              {page}
            </a>
          )
        ))}

        {gamesPage.currentPage < gamesPage.totalPages && (
          <a
            href={pagePath(gamesPage.currentPage + 1)}
            aria-label="Go to next page"
            class="rounded-lg border border-slate-700 px-4 py-2 text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
            data-testid="pagination-next"
          >
            Next
          </a>
        )}
      </nav>
    )}
  </>
)}

<script>
  import { matchesGameTitle } from '../lib/game-search';

  const searchInput = document.querySelector<HTMLInputElement>('[data-testid="game-search-input"]');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-testid="game-card"]'));
  const pagination = document.querySelector<HTMLElement>('[data-testid="pagination"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="search-empty-state"]');
  const currentPageGameIds = new Set(
    cards.filter((card) => !card.hidden).map((card) => card.dataset.gameId),
  );

  searchInput?.addEventListener('input', () => {
    const query = searchInput.value;
    const isSearching = query.trim().length > 0;
    let visibleMatches = 0;

    cards.forEach((card) => {
      const matches = matchesGameTitle(card.dataset.gameTitle ?? '', query);
      const shouldShow = isSearching
        ? matches
        : currentPageGameIds.has(card.dataset.gameId);

      card.hidden = !shouldShow;
      if (shouldShow && isSearching) {
        visibleMatches += 1;
      }
    });

    if (pagination) {
      pagination.hidden = isSearching;
    }
    if (emptyState) {
      emptyState.hidden = !isSearching || visibleMatches > 0;
    }
  });
</script>
